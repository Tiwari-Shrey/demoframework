{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true,
    "types": [
      "node",
      "@playwright/test"
    ],
    "paths": {
      "@pages/*": [
        "./pages/*"
      ],
      "@core/*": [
        "./core/*"
      ],
      "@testdata/*": [
        "./testdata/*"
      ]
    }
  },
  "include": [
    "pages/**/*.ts",
    "core/**/*.ts",
    "testdata/**/*.ts",
    "tests/**/*.ts"
  ]
}
