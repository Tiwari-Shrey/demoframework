{
  "name": "aswatson_automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test normal-shelf-WTCTH-allow-overhung-n.spec.ts",
    "test:sit": "cross-env ENV=SIT playwright test WTCTH-normal-shelf-workflow.spec.ts",
    "test:qa": "cross-env ENV=QA playwright test",
    "test:headed": "playwright test --headed",
    "test:regression": "playwright test --grep @regression",
    "test:regression:coverage": "c8 --include=\"pages/**,core/**,tests/**\" --reporter=html playwright test --grep @regression && playwright show-report reports/playwright-report & start coverage/index.html",
    "test:list": "playwright test --list",
    "report:single": "start reports/custom-report/index.html",
    "allure:clean": "node -e \"const fs=require('fs'); fs.rmSync('reports/allure-results',{recursive:true,force:true}); fs.rmSync('reports/allure-report',{recursive:true,force:true})\"",
    "test:allure": "npm run allure:clean && npm run test || exit 0",
    "report:allure": "allure generate reports/allure-results --output reports/allure-report",
    "report:open": "allure open reports/allure-report",
    "report:serve": "allure serve --cwd reports",
    "allure": "npm run test:allure && npm run report:allure && npm run report:open",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agents:init": "playwright init-agents --loop=vscode"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harshit-Malpani_aswatson/ASWatson_Automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/cli": "^0.1.18",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/oracledb": "^7.0.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "allure": "^3.15.0",
    "allure-playwright": "^3.10.2",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "oracledb": "^7.0.1",
    "pino-pretty": "^13.1.3",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@playwright/mcp": "^0.0.79",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "playwright": "^1.62.1"
  },
  "allowScripts": {
    "oracledb@7.0.1": true
  },
  "c8": {
    "include": [
      "pages/**",
      "core/**",
      "tests/**"
    ],
    "exclude": [
      "node_modules/**",
      "allure-report/**",
      "reports/**"
    ],
    "reporter": [
      "text",
      "html"
    ],
    "all": true
  }
}
