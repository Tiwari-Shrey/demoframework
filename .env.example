BASE_URL=https://lunch.sdettech.com
EMPLOYEE_ID=
# Set to true on machines without a visible desktop (CI, runners, services)
HEADLESS=false
# Optional: msedge or chrome to use the installed browser instead of bundled Chromium
BROWSER_CHANNEL=
# Optional: false = fixed-size window instead of maximized
START_MAXIMIZED=true
# Fixed window size when START_MAXIMIZED=false (keep it smaller than the screen)
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
